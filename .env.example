# Copie para .env se quiser mudar algo. O arquivo .env nunca deve ir para o GitHub.
# Tudo é opcional: sem .env, `docker compose up --build` já sobe com valores seguros.

# Segredo que assina os tokens de login (mínimo 32 caracteres).
# É o MESMO para todos os serviços: o de Usuários assina, os outros conferem.
# Deixe vazio para o docker compose gerar um aleatório na primeira subida (fica no volume "segredo").
# Para gerar o seu: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=

# Tempo de validade do login, em minutos
TOKEN_MINUTOS=60

# 1 = cria usuários, equipamentos e chamados de exemplo (só para aula)
DADOS_EXEMPLO=1
# Senha dos usuários de exemplo
SENHA_EXEMPLO=Helpdesk2026
